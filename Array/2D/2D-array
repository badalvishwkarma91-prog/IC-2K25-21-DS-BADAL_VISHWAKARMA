#include <iostream>
using namespace std;

int main() {
    int arr[2][3];

    
    cout << "Enter 6 elements:\n";
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 3; j++) {
            cin >> arr[i][j];
        }
    }

   
   for (int i = 0; i < 2; i++) {
    for (int j = 0; j < 3; j++) {
        arr[i][j] = arr[i][j] + 1;   // or arr[i][j]++;
    }
}

cout << "\n2D Array Elements:\n";
for (int i = 0; i < 2; i++) {
    for (int j = 0; j < 3; j++) {
        cout << arr[i][j] << " ";
    }
    cout << endl;
}
return 0;
}
