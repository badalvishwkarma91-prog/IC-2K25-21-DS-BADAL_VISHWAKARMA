#include <iostream>
using namespace std;

int main()
{
    int stack[5];
    int top = -1;
    int value;

    // Push 3 elements
    for (int i = 0; i < 3; i++)
    {
        cout << "Enter value: ";
        cin >> value;

        top++;
        stack[top] = value;
    }

    // Display stack
    cout << "\nStack elements are:\n";

    for (int i = top; i >= 0; i--)
    {
        cout << stack[i] << endl;
    }
    return 0;
  }
